<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.task.ExtractPositionMapper">

    <!-- 插入提取位置 -->
    <insert id="insert" parameterType="java.util.Map">
        INSERT INTO extract_position (role_id, extract_position)
        VALUES
        <foreach collection="extractPosition" item="position" separator=",">
            (#{roleId}, #{position})
        </foreach>
    </insert>

    <!-- 其他查询操作可继续添加 -->

</mapper>

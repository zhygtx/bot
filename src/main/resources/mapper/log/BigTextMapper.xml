<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.log.BigTextMapper">

    <insert id="insertBatch">
        insert into big_text(`key`, value)
        values
        <foreach collection="bigTextList" item="item" separator=",">
            (#{item.key}, #{item.value})
        </foreach>
    </insert>

</mapper>
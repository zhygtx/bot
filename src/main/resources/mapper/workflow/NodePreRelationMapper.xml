<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.workflow.NodePreRelationMapper">

    <insert id="insert" parameterType="java.util.Map">
        insert into node_pre_relation(node_id, pre_node_id) values
        <foreach item="preNodeId" collection="_parameter" separator=",">
            (#{key}, #{preNodeId})
        </foreach>
    </insert>

</mapper>
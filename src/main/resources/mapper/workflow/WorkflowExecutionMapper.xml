<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.generalbot.workflow.mapper.WorkflowExecutionMapper">

    <resultMap id="executionMap" type="com.generalbot.workflow.entity.execution.WorkflowExecution">
        <id column="id" property="id"/>
        <result column="workflow_id" property="workflowId"/>
        <result column="user_id" property="userId"/>
        <result column="trigger_key" property="triggerKey"/>
        <result column="workflow_name" property="workflowName"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="expected_node_count" property="expectedNodeCount"/>
        <result column="actual_node_count" property="actualNodeCount"/>
        <result column="error_message" property="errorMessage"/>
        <result column="trace" property="trace"
                typeHandler="com.generalbot.workflow.typehandler.ExecutionTraceTypeHandler"/>
    </resultMap>

    <sql id="summaryColumns">
        SELECT id, workflow_id, user_id, trigger_key, workflow_name, status,
               start_time, end_time, duration_ms, expected_node_count, actual_node_count, error_message
        FROM workflow_execution
    </sql>

    <insert id="insert" parameterType="com.generalbot.workflow.entity.execution.WorkflowExecution"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workflow_execution (
            workflow_id, user_id, trigger_key, workflow_name, status,
            start_time, end_time, duration_ms, expected_node_count, actual_node_count, error_message, trace
        ) VALUES (
            #{workflowId}, #{userId}, #{triggerKey}, #{workflowName}, #{status},
            #{startTime}, #{endTime}, #{durationMs}, #{expectedNodeCount}, #{actualNodeCount}, #{errorMessage},
            #{trace, typeHandler=com.generalbot.workflow.typehandler.ExecutionTraceTypeHandler}
        )
    </insert>

    <select id="selectById" resultMap="executionMap" parameterType="long">
        SELECT id, workflow_id, user_id, trigger_key, workflow_name, status,
               start_time, end_time, duration_ms, expected_node_count, actual_node_count, error_message, trace
        FROM workflow_execution
        WHERE id = #{id}
    </select>

    <select id="selectPage" resultMap="executionMap">
        <include refid="summaryColumns"/>
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="workflowId != null and workflowId != ''">
                AND workflow_id = #{workflowId}
            </if>
            <if test="workflowName != null and workflowName != ''">
                AND workflow_name LIKE CONCAT('%', #{workflowName}, '%')
            </if>
            <if test="startTime != null">
                AND start_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND start_time &lt;= #{endTime}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND trace LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        <choose>
            <when test="sortField == 'actualNodeCount'">
                ORDER BY actual_node_count
                <choose>
                    <when test="sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <when test="sortField == 'executionTime'">
                ORDER BY duration_ms
                <choose>
                    <when test="sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY start_time DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectStatsByWorkflowIds" resultType="java.util.Map">
        SELECT workflow_id AS workflowId,
               COUNT(*) AS executeCount,
               AVG(duration_ms) AS averageExecutionTime,
               AVG(actual_node_count) AS averageNodeCount
        FROM workflow_execution
        WHERE workflow_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY workflow_id
    </select>

    <delete id="deleteByWorkflowId">
        DELETE FROM workflow_execution
        WHERE workflow_id = #{workflowId}
    </delete>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.BotMapper">

    <update id="update">
        update bot
        <set>
            <if test="name != null and name != ''">name = #{name}</if>
            <if test="botQQ != null and botQQ != ''">bot_qq = #{botQQ}</if>
            <if test="pathSuffix != null and pathSuffix != ''">
                path_suffix = #{pathSuffix} and token =#{token}
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>